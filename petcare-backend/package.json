{
  "name": "petcare-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de PetCare (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-reporter=spec --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/*.test.js\"",
    "test:api": "node --test --test-reporter=spec --test-concurrency=1 \"tests/api/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
